# Create .env from this template for the ALWAYS-ON Docker host.
# NEVER commit .env or paste keys in chat.
OWNER_TOKEN=REPLACE_WITH_RANDOM_32_CHAR_OR_LONGER
BROWSER_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_CHAR_OR_LONGER
OMNIROUTE_API_KEY=private-internal-router
OMNIROUTE_MODEL=auto
# OPTIONAL: FreeLLMAPI. When this key is nonempty, it takes priority over
# OmniRoute; leave blank to preserve the working OmniRoute setup.
# Get the unified freellmapi-... key from your local http://127.0.0.1:3001 dashboard.
# Never paste this key into the Vercel dashboard, frontend, GitHub or chat.
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto:smart
# For the optional Docker service (compose profile freellmapi):
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
# Required 64-character random hexadecimal key for encrypting provider keys.
# Generate it locally once and NEVER change without rotating stored credentials.
FREELLMAPI_ENCRYPTION_KEY=

# Backend domain: must point to your Docker host and have reachable ports 80/443.
AGENT_BACKEND_DOMAIN=agent.example.com
# Vercel domain + backend domain; both HTTPS. Exact origins, comma separated.
APP_ORIGIN=https://your-app.vercel.app,https://agent.example.com
# Optional browser isolate and provider credentials
WEB_SEARCH_PROVIDER=parallel
# PROVIDER API KEYS must be entered in OmniRoute's private dashboard.
# For hosted features, configure these separately when needed:
# VOICE_API_KEY=
# VOICE_MODEL=
# CPK_INTELLIGENCE_API_KEY=
# COMPOSIO_API_KEY=
# COMPUTER_SUPERVISOR_URL=
# COMPUTER_SUPERVISOR_TOKEN=
# COMPUTER_TOKEN=
# OMNIROUTE_WS_BRIDGE_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
