{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/client",
  "installCommand": "npm ci --ignore-scripts",
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?__opendots_path=:path*"
    }
  ]
}
