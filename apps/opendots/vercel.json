{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node --test tests/vercel-proxy.node.mjs && node --import tsx --test tests/client-api-null.node.mjs && npm run build:web",
  "outputDirectory": "dist/client",
  "installCommand": "npm ci --ignore-scripts",
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kanish.tail7524cf.ts.net/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-OpenDots-Route",
          "value": "external-funnel-v3"
        }
      ]
    }
  ]
}
